{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}", "${workspaceFolder}/test/sample"],
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "preLaunchTask": "npm: compile"
    },
    {
      "name": "Debug Adapter Server",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/out/src/adapter/main.js",
      "outFiles": ["${workspaceFolder}/out/**/*.js"]
    }
  ]
}
